#!/usr/bin/env bash
# Pre-commit hook: block commits containing real financial data patterns.
# Install: git config core.hooksPath .githooks
set -euo pipefail

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
[[ -z "$STAGED" ]] && exit 0

BLOCKED=0

for file in $STAGED; do
    # Skip binary files
    if file "$file" | grep -q "binary"; then
        continue
    fi

    content=$(git show ":$file" 2>/dev/null) || continue

    # Check for UK sort code patterns (NN-NN-NN) — must NOT be part of a date
    # Strip ISO dates (YYYY-MM-DD), UK dates (DD-MM-YYYY), and strftime patterns first
    if echo "$content" \
        | sed -E 's/[0-9]{4}-[0-9]{2}-[0-9]{2}//g' \
        | sed -E 's/[0-9]{2}-[0-9]{2}-[0-9]{4}//g' \
        | sed -E 's/%[dDmMyYHMSIpBbAa]//g' \
        | grep -qE '[0-9]{2}-[0-9]{2}-[0-9]{2}'; then
        echo "BLOCKED: '$file' contains what looks like a UK sort code"
        BLOCKED=1
    fi

    # Check for account number patterns (8 consecutive digits)
    if echo "$content" | grep -qE 'account.?(number|no)[^0-9]*[0-9]{8}' ; then
        echo "BLOCKED: '$file' contains what looks like an account number"
        BLOCKED=1
    fi

    # Check for National Insurance number patterns
    if echo "$content" | grep -qiE '[A-Z]{2}[0-9]{6}[A-D]'; then
        echo "BLOCKED: '$file' contains what looks like a National Insurance number"
        BLOCKED=1
    fi

    # Check for IBAN patterns
    if echo "$content" | grep -qE '[A-Z]{2}[0-9]{2}[A-Z0-9]{4}[0-9]{7}([A-Z0-9]?){0,16}'; then
        echo "BLOCKED: '$file' may contain an IBAN"
        BLOCKED=1
    fi
done

if [[ $BLOCKED -eq 1 ]]; then
    echo ""
    echo "Commit blocked: possible financial data detected."
    echo "If this is a false positive, use --no-verify to bypass."
    exit 1
fi

exit 0
